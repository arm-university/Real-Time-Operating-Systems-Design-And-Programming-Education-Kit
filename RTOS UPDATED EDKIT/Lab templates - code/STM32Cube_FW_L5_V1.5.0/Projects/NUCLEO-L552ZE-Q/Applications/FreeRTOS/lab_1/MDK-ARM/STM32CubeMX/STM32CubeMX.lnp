"stm32cubemx\stm32l5xx_hal_pwr_ex.o"
"stm32cubemx\stm32l5xx_hal.o"
"stm32cubemx\stm32l5xx_hal_i2c.o"
"stm32cubemx\stm32l5xx_hal_i2c_ex.o"
"stm32cubemx\stm32l5xx_hal_rcc.o"
"stm32cubemx\stm32l5xx_hal_rcc_ex.o"
"stm32cubemx\stm32l5xx_hal_flash.o"
